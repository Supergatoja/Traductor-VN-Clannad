<Window x:Class="SeenExtractor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:y="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SeenExtractor"
        xmlns:ReadDialog="clr-namespace:SeenExtractor.Data.Models.Lectura"
        mc:Ignorable="d"
        Title="Read-Write Seen" Height="960" Width="1280"
        FontFamily="{StaticResource Klee_One_SB}">


    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Find" Executed="CommandBinding_Executed" CanExecute="CommandBinding_CanExecute"/>
        <CommandBinding Command="{x:Static local:MainWindowHelpers.Next}" Executed="NextDialog" CanExecute="NextDialog_CanExecute"/>
        <CommandBinding Command="{x:Static local:MainWindowHelpers.Before}" Executed="BeforeDialog" CanExecute="BeforeDialog_CanExecute"/>
        <CommandBinding Command="ApplicationCommands.Open" Executed="SeenOriginal_Click" />
        <CommandBinding Command="ApplicationCommands.New" Executed="DialogosNuevos_Click" />
        <CommandBinding Command="ApplicationCommands.Save" Executed="Guardar_Mezclar_Click" CanExecute="CommandBinding_CanExecute_1"/>
        <CommandBinding Command="{x:Static local:MainWindowHelpers.Lectura_Masiva}" Executed="OpenFolderDialogs_Click" />
        <CommandBinding Command="{x:Static local:MainWindowHelpers.Export}" Executed="ExportDialogs_Click" />
        <!--<CommandBinding Command="{x:Static local:MainWindow.Open_Clean_Trans}" Executed="DialogosNuevosClean_Click" />-->
        <CommandBinding Command="ApplicationCommands.Replace" Executed="Replace_Executed" />
        <CommandBinding Command="{x:Static local:MainWindowHelpers.CleanTranslate}" Executed="CleanTranslate_Executed" CanExecute="CleanTranslate_CanExecute" />
    </Window.CommandBindings>

    <Window.InputBindings>
        <KeyBinding Key="F6"
              Command="{x:Static local:MainWindowHelpers.Next}" />
        <KeyBinding Key="F6"
              Modifiers="Control" 
              Command="{x:Static local:MainWindowHelpers.Before}" />
        <KeyBinding Key="M"
              Modifiers="Control" 
              Command="{x:Static local:MainWindowHelpers.Lectura_Masiva}" />
        <KeyBinding Key="E"
              Modifiers="Control" 
              Command="{x:Static local:MainWindowHelpers.Export}" />
        <KeyBinding Key="N"
              Modifiers="Shift" 
              Command="{x:Static local:MainWindowHelpers.Open_Clean_Trans}" />
        <KeyBinding Gesture="CTRL+SHIFT+N"
              Command="{x:Static local:MainWindowHelpers.CleanTranslate}" />
    </Window.InputBindings>

    <Window.Resources>

        <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <!--<Setter Property="Background" Value="Black"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="Transparent"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#333333"/>
            <Setter Property="VerticalGridLinesBrush" Value="#333333"/>-->
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserResizeColumns" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="CanUserSortColumns" Value="True"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ClipboardCopyMode" Value="ExcludeHeader"/>
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>

        <!--<Style TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8,5,8,5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="#222222" 
                    BorderBrush="#444444" 
                    BorderThickness="0,0,1,1" 
                    Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>-->

        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="1,1,1,1"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>

        </Style>

        <Style TargetType="StatusBar" BasedOn="{StaticResource {x:Type StatusBar}}">
            <Setter Property="Padding" Value="0.5"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="11*"></RowDefinition>
            <RowDefinition Height="30"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.RowSpan>5</Grid.RowSpan>

        <ToolBarTray Grid.Column="0">
            <ToolBar Band="1" BandIndex="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                <Button Click="Button_Click" >Convertir a CP932</Button>
                <Separator/>
                <Button Height="auto" Command="ApplicationCommands.Open" >Abrir Seen</Button>
                <Button Height="auto" Command="ApplicationCommands.New" >Abrir Traducción</Button>
                <Button Height="auto" Command="{x:Static local:MainWindowHelpers.Lectura_Masiva}" >Abrir Carpeta</Button>
                <Button Height="auto" Command="{x:Static local:MainWindowHelpers.Open_Clean_Trans}" ToolBar.OverflowMode="Always" >Abrir Traducción L</Button>
                <Separator/>
                <Button Height="auto" Command="{x:Static local:MainWindowHelpers.Export}" >Extraer Dialogos</Button>
                <Button Height="auto" Click="SuistituirCaracteres_Click" >Sustituir Acentos, Caracter especial</Button>
                <Button Height="auto" Command="ApplicationCommands.Save" >Guardar/Mezclar</Button>
                <Button Height="auto" Command="ApplicationCommands.Find" >Buscar</Button>
            </ToolBar>
        </ToolBarTray>


        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>



            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="5*"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>


                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                    </Grid.RowDefinitions>

                </Grid>



            </Grid>
            <Popup x:Name="StatusPopUp" Grid.Column="0">
                <StackPanel>
                    <TextBlock x:Name="MSJStatusPopUp" Padding="7">
                    </TextBlock>
                </StackPanel>
            </Popup>

        </Grid>

        <Grid Grid.Row="1" VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" x:Name="tamañoOriginal"></ColumnDefinition>
                <ColumnDefinition Width="0" x:Name="tamañoNuevo"></ColumnDefinition>
            </Grid.ColumnDefinitions>


            <DataGrid x:Name="OriginalDialogs" Grid.Column="0" SelectionChanged="LineaSelectOriginal" ClipToBounds="True" VerticalAlignment="Stretch" >

                <DataGrid.Columns >

                    <DataGridTextColumn Header="Línea" Binding="{Binding Line}" IsReadOnly="True" Width="Auto"/>


                    <DataGridTextColumn Header="Personaje" Binding="{Binding Character}" IsReadOnly="True" Width="Auto"/>

                    <DataGridTemplateColumn Header="Texto Extraído" Width="*">

                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Dialog, Mode=OneWay}" TextWrapping="Wrap" Padding="4"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>


            <DataGrid x:Name="NuevosDialogs" Grid.Column="1" SelectionChanged="LineaSelectNuevo" Visibility="Collapsed" >
                <DataGrid.Columns >

                    <DataGridTextColumn Header="Línea" Binding="{Binding Line}" IsReadOnly="True" Width="Auto" />

                    <DataGridTextColumn Header="Personaje" Binding="{Binding Character}" IsReadOnly="True" Width="Auto"/>

                    <DataGridTemplateColumn Header="Texto Extraído" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Dialog, Mode=OneWay}" TextWrapping="Wrap" Padding="4">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Excede}" Value="true">
                                                    <Setter Property="Foreground" Value="Red"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Excede}" Value="false">
                                                    <Setter Property="Foreground" Value="White"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Dialog, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                         TextWrapping="Wrap"
                                         BorderThickness="0"
                                         MaxLength="{Binding Length}"
                                         >
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding Excede}" Value="true">
                                                        <Setter Property="Foreground" Value="Red"/>
                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding Excede}" Value="false">
                                                    <Setter Property="Foreground" Value="White"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>

                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <!--
                    <DataGridCheckBoxColumn Header="¿Uso de Japones?" Width="50" Binding="{Binding Japones, Mode=TwoWay, UpdateSourceTrigger=LostFocus}">
                        
                    </DataGridCheckBoxColumn>
                    -->
                </DataGrid.Columns>

            </DataGrid>

        </Grid>

        <StatusBar x:Name="Status" Grid.Row="2">
            <StatusBarItem>
                <TextBlock Text="Extrayendo"/>
            </StatusBarItem>
            <StatusBarItem  HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Grid.Row="1" Width="120" Height="15" Visibility="Collapsed" x:Name="ProgressBar" VerticalAlignment="Center"></ProgressBar>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock x:Name="InfoData"></TextBlock>
            </StatusBarItem>
        </StatusBar>

    </Grid>

</Window>

<Window x:Class="SeenExtractor.Data.Views.Search.Search"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SeenExtractor.Data.Views.Search"
        xmlns:Replace="clr-namespace:SeenExtractor.Data.Views.Replace"
        mc:Ignorable="d"
        FontFamily="{StaticResource Klee_One_SB}"
        Title="Search" Height="300" Width="800"
        ResizeMode="NoResize">

    <Window.Resources>

        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="1,1,1,1"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>

        </Style>

    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="20"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Button x:Name="btnBuscar" Grid.Column="0">Buscar</Button>
            <Button x:Name="btnRemplazar" Grid.Column="1">Remplazar</Button>
        </Grid>

        <WrapPanel Grid.Row="1" Visibility="Collapsed" x:Name="ViewBuscar" >
            <local:ViewSearch x:Name="Buscar" Height="280" Width="800" Padding="7"></local:ViewSearch>
        </WrapPanel>
        <WrapPanel Grid.Row="1" Visibility="Collapsed" x:Name="ViewRemplazar">
            <Replace:ViewReplace x:Name="Remplazar" Height="280" Width="800" Padding="7"></Replace:ViewReplace>
        </WrapPanel>
    </Grid>
</Window>

<UserControl x:Class="SeenExtractor.Data.Views.Search.ViewSearch"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SeenExtractor.Data.Views.Search"
      mc:Ignorable="d" 
      DataContextChanged="UserControl_DataContextChanged"
      d:DesignHeight="330" d:DesignWidth="800"
      >

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>
            <TextBox Grid.Row="0" x:Name="valor" AcceptsReturn="False" VerticalScrollBarVisibility="Auto" Height="30"/>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>
                
                <CheckBox Grid.Column="0" Grid.Row="0" x:Name="chbCharacter" />
                <TextBlock Grid.Column="1" Grid.Row="0" Text="Busqueda por personaje" VerticalAlignment="Center" />
                <CheckBox Grid.Column="0" Grid.Row="1" x:Name="chbSensible" />
                <TextBlock Grid.Column="1" Grid.Row="1" Text="Busqueda Sensible (Mayuscular)"  VerticalAlignment="Center" />
            </Grid>
        </Grid>

        <Grid Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Name="Searchbtn" Click="Search_Click">Buscar</Button>
            <Button Grid.Column="1" Click="Cerrar_Click" Name="Cerrar">Cancelar</Button>

        </Grid>
    </Grid>
</UserControl>

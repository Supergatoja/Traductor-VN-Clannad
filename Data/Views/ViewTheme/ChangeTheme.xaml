<Window x:Class="SeenExtractor.Data.Views.ViewTheme.ChangeTheme"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SeenExtractor.Data.Views.ViewTheme"
        mc:Ignorable="d"
        Title="Cambio de tema" Height="400" Width="800"
        Topmost="True"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        WindowStyle="None"
        FontFamily="{StaticResource Klee_One_SB}"
        Background="Transparent">

    <Border x:Name="MainBorder" 
            Background="#E91E1E1E" 
            BorderBrush="#3F3F3F" 
            BorderThickness="1" 
            CornerRadius="8"
            Margin="6">

        <Border.Effect>
            <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="4" Opacity="0.4" Color="Black"/>
        </Border.Effect>

        <Grid RowDefinitions="30,*">

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" 
                           Foreground="#CCCCCC" 
                           VerticalAlignment="Center" 
                           Margin="10,0,0,0" 
                           FontSize="12"/>

                <Button Grid.Column="1" 
                        Content="✕" 
                        Foreground="White" 
                        Background="Transparent" 
                        BorderBrush="Transparent"
                        Width="30" Height="25"
                        Click="CloseButton_Click"
                        HorizontalAlignment="Right"
                        Margin="0,0,5,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#E81123"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <WrapPanel Grid.Row="1" x:Name="ViewThemes" Visibility="Collapsed">
                <local:Themes Height="356" Width="786" Padding="7"></local:Themes>
            </WrapPanel>
            
        </Grid>
    </Border>
</Window>

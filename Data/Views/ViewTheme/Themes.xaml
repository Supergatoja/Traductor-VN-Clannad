<UserControl x:Class="SeenExtractor.Data.Views.ViewTheme.Themes"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SeenExtractor.Data.Views.ViewTheme"
             mc:Ignorable="d" 
             d:DesignHeight="356" d:DesignWidth="786">
    <Grid>
        <Grid RowDefinitions="30,*,30">

            <Label Grid.Row="0">Hola Mundo desde Control User</Label>

            <Grid Grid.Row="1" ColumnDefinitions="*,*" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

                <ComboBox Grid.Column="0" Width="205" x:Name="cmbThemes" DisplayMemberPath="Descripcion" SelectedValuePath="Value" HorizontalAlignment="Center" SelectionChanged="cmbThemes_SelectionChanged" ></ComboBox>
                <!--<Button Grid.Column="1" Name="PickColor" Click="PickColor_Click">Eligue un color</Button>-->
                <Border
                    Grid.Column="1"
                    BorderThickness="1"
                    BorderBrush="#807FFFF4"
                    Padding="10"
                    CornerRadius="10"
                    IsEnabled="False"
                    x:Name="PickColor"
                    Background="#20F1F1F1">
                    
                    <Grid RowDefinitions="auto,auto,auto,auto,auto,auto" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="ColorPreviewBox" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                            Height="60" Margin="0,0,0,15" CornerRadius="5" Background="Black"
                            BorderBrush="Gray" BorderThickness="1"/>

                        <TextBlock Text="Rojo (R):" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                        <Slider x:Name="SliderR" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="255" Value="0" 
                            TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="ColorSlider_ValueChanged" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtR" Grid.Row="1" Grid.Column="2" Text="0" VerticalAlignment="Center" Margin="10,0,0,0"/>

                        <TextBlock Text="Verde (G):" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                        <Slider x:Name="SliderG" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="255" Value="0" 
                            TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="ColorSlider_ValueChanged" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtG" Grid.Row="2" Grid.Column="2" Text="0" VerticalAlignment="Center" Margin="10,0,0,0"/>

                        <TextBlock Text="Azul (B):" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
                        <Slider x:Name="SliderB" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="255" Value="0"
                            TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="ColorSlider_ValueChanged" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtB" Grid.Row="3" Grid.Column="2" Text="0" VerticalAlignment="Center" Margin="10,0,0,0"/>

                        <TextBlock Text="Opacidad:" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center"/>
                        <Slider x:Name="SliderO" Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="255" Value="255"
                            TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="ColorSlider_ValueChanged" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtO" Grid.Row="4" Grid.Column="2" Text="255" VerticalAlignment="Center" Margin="10,0,0,0"/>

                        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,15,0,0">
                            <TextBlock Text="Código HEX: " FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtHex" Width="100" IsReadOnly="True" VerticalAlignment="Center" Text="#FF000000"/>
                        </StackPanel>
                    </Grid>
                    
                </Border>

            </Grid>

            <Grid Grid.Row="2" ColumnDefinitions="*,*" >
                <Button Grid.Column="0" Content="Aplicar" Name="AplicarTheme" Click="AplicarTheme_Click" HorizontalAlignment="Center"></Button>
                <Button Grid.Column="1" Content="Cancelar" Name="Close" Click="Close_Click" HorizontalAlignment="Center"></Button>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

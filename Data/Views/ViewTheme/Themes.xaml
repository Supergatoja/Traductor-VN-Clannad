<UserControl x:Class="SeenExtractor.Data.Views.ViewTheme.Themes"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SeenExtractor.Data.Views.ViewTheme"
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="800">
    <Grid>
        <Grid RowDefinitions="30,*,30">

            <Label Grid.Row="0">Hola Mundo desde Control User</Label>

            <ComboBox Grid.Row="1" x:Name="cmbThemes" DisplayMemberPath="Descripcion" SelectedValuePath="Value">
            </ComboBox>

            <Grid Grid.Row="2" ColumnDefinitions="auto,auto">
                <Button Grid.Column="0" Content="Aplicar" Name="AplicarTheme" Click="AplicarTheme_Click" ></Button>
                <Button Grid.Column="1" Content="Cancelar" Name="Close" Click="Close_Click"></Button>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
